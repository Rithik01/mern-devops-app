# Copy this file to ".env" and adjust. NEVER commit the real .env file.
# docker compose reads ".env" in this folder automatically.

# ---------- Backend ----------
PORT=5000
NODE_ENV=development
# Docker Compose: the host name "mongo" is the compose service name.
MONGO_URI=mongodb://mongo:27017/mern_devops
# Running the backend WITHOUT Docker (npm run dev)? Use localhost instead:
# MONGO_URI=mongodb://localhost:27017/mern_devops
# Later (AWS): a MongoDB Atlas string, e.g.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern_devops

# Optional: restrict which website may call the API (default: any)
# CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
# URL the BROWSER uses to reach the backend (read at build time by Vite).
VITE_API_URL=http://localhost:5000/api
